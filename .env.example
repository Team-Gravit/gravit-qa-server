# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# 이미지
DOCKER_HUB_USERNAME=

# 포트 / 자원 한도 (02_PREP_GUIDE Part 2 #12)
QA_API_PORT=
QA_API_CPUS=
QA_API_MEMORY=
QA_E2E_CPUS=
QA_E2E_MEMORY=

# DB (Part 2 #11)
QA_DB_URL=jdbc:postgresql://<host>:<port>/gravit_qa
QA_DB_USERNAME=
QA_DB_PASSWORD=

# 관리자 판정 대상: admin-web이 바라보는 환경의 gravit-server (현재 dev, 전환 후 prod)
QA_AUTH_HOST=https://grav-it-dev.inuappcenter.kr

# 외부 연동 (C3, .claude/spec/secret-convention.md). qa-api 컨테이너만 쓴다
FIGMA_TOKEN=
NOTION_TOKEN=
GITHUB_TOKEN=
LITELLM_API_KEY=
